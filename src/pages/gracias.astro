---
import Layout from '../layouts/Layout.astro';
import { cld } from '../lib/cloudinary';
import GradientText from '../components/reactbits/GradientText.tsx';
import { GRAD_COOL, GRAD_WARM, GRAD_DIRECTION } from '../data/gradients';

// Segundos antes de volver automáticamente al inicio.
const REDIRECT_SECONDS = 6;
---

<Layout
  title="¡Gracias! · Universo Crafter"
  description="Recibimos tu mensaje. Te responderemos pronto para ayudarte a darle forma a tu proyecto de papelería personalizada."
  noindex
>
  <!--
    Guarda de acceso: /gracias solo es válida si se llega tras enviar
    el formulario. La bandera se pone en Contacto.astro al hacer submit.
    Se ejecuta ANTES de renderizar el contenido para evitar parpadeo.
  -->
  <script is:inline>
    (function () {
      var KEY = 'uc:form-enviado';
      try {
        var sello = sessionStorage.getItem(KEY);
        sessionStorage.removeItem(KEY); // un solo uso
        var ok = false;
        if (sello) {
          var ts = parseInt(sello, 10);
          // Válida solo si el envío ocurrió en los últimos 5 minutos.
          ok = !isNaN(ts) && Date.now() - ts < 5 * 60 * 1000;
        }
        if (!ok) window.location.replace('/');
      } catch (e) {
        // Si sessionStorage no está disponible, no atrapamos al usuario.
      }
    })();
  </script>

  <main
    class="grid min-h-screen place-items-center bg-[linear-gradient(90deg,#fdf0f5_0%,#fcf5fa_22%,#f4f5fc_50%,#e9f3fb_66%,#ece4fb_100%)] px-5 py-16"
  >
    <div class="mx-auto max-w-xl text-center">
      <img
        src={cld('escribenos.png', 480)}
        width="200"
        height="200"
        alt=""
        decoding="async"
        class="mx-auto w-40 object-contain drop-shadow-[0_16px_24px_rgb(43_36_54/0.18)] md:w-52"
      />

      <h1 class="mt-6 font-display text-6xl leading-[0.95] sm:text-7xl">
        <GradientText colors={GRAD_WARM} direction={GRAD_DIRECTION}>¡Gracias por</GradientText>{' '}<GradientText colors={GRAD_COOL} direction={GRAD_DIRECTION}>escribirnos!</GradientText>
      </h1>

      <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-tinta">
        Recibimos tu mensaje y te responderemos muy pronto para ayudarte a darle
        forma a tu idea. ✨
      </p>

      <p class="mt-4 text-sm text-tinta-suave">
        Te llevaremos de vuelta al inicio en
        <span id="cuenta" class="font-bold text-tinta">{REDIRECT_SECONDS}</span>
        segundos…
      </p>

      <a
        href="/"
        class="mt-8 inline-block rounded-2xl bg-oscuro px-7 py-4 text-base font-semibold text-white transition-transform hover:-translate-y-0.5"
      >
        Volver al inicio ahora
      </a>
    </div>
  </main>
</Layout>

<script define:vars={{ REDIRECT_SECONDS }}>
  (() => {
    // 1. Sanear entrada
    const segundos = Number.isFinite(Number(REDIRECT_SECONDS))
      ? Math.max(0, Math.floor(Number(REDIRECT_SECONDS)))
      : 0;

    // 2. Si no hay tiempo válido, redirigir ya (y salir)
    if (segundos <= 0) {
      window.location.replace('/');
      return;
    }

    const nodo = document.getElementById('cuenta');
    if (nodo) {
      nodo.setAttribute('aria-live', 'polite');
      nodo.textContent = segundos;
    }

    const inicio = performance.now(); // 3. Iniciar temporizador
    
    const intervalo = setInterval(() => {
      const transcurrido = (performance.now() - inicio) / 1000;
      const restante = Math.max(0, Math.ceil(segundos - transcurrido));

      if (nodo) nodo.textContent = restante;

      if (restante <= 0) {
        clearInterval(intervalo);
        window.location.replace('/');
      }
    }, 250);
  })();
</script>
