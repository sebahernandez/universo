---
import { cld } from '../lib/cloudinary';
import TextLoop from './reactbits/TextLoop.tsx';

// Imágenes de fondo del Hero (Cloudinary), servidas optimizadas vía cld().
// Fondo distinto por breakpoint: vertical en móvil, horizontal en escritorio.
const heroBgDesktop = cld(
  'https://res.cloudinary.com/v5ovpy2d/image/upload/v1791166382/bg-hero-universocrafter.avif',
  1920,
);
const heroBgMobile = cld(
  'https://res.cloudinary.com/v5ovpy2d/image/upload/v1791166852/bg-movil-universocrafter.avif',
  900,
);
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Fondo móvil (vertical): solo hasta md. -->
  <div
    class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat md:hidden"
    style={`background-image:url('${heroBgMobile}')`}
    aria-hidden="true"
  >
  </div>
  <!-- Fondo escritorio/tablet (horizontal): desde md. -->
  <div
    class="absolute inset-0 z-0 hidden bg-cover bg-center bg-no-repeat md:block"
    style={`background-image:url('${heroBgDesktop}')`}
    aria-hidden="true"
  >
  </div>

  <!-- Velo suave para legibilidad del texto (más opaco a la izquierda, se desvanece a la derecha). -->
  <div
    class="pointer-events-none absolute inset-0 z-0"
    style="background:linear-gradient(100deg,rgba(255,255,255,0.72) 0%,rgba(255,255,255,0.4) 38%,rgba(255,255,255,0) 68%)"
    aria-hidden="true"
  >
  </div>

  <div id="inicio-main" class="relative z-10">
    <div class="mx-auto flex min-h-[30rem] max-w-sitio flex-col items-center justify-center px-5 pt-28 pb-10 text-center sm:min-h-[34rem] md:min-h-140 md:px-8 md:pt-32 md:pb-20 lg:min-h-170">
      <div class="min-w-0">
        <!-- Badge de categoría -->
        <span class="inline-block rounded-full bg-rosa px-4 py-1.5 text-xs font-bold tracking-[0.18em] text-rosa-fuerte uppercase">
          Papelería Creativa
        </span>

        <h1 class="mt-5 font-display text-5xl leading-[1.08] text-black sm:text-6xl lg:text-7xl xl:text-8xl">
          <span class="block">Ideas que</span>
          <span class="block">hacen tu mundo</span>
          <span class="block">más lindo</span>
        </h1>

        <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-black sm:text-lg">
          Papelería, stickers y productos creativos para regalar, decorar y
          organizar tu día a día.
        </p>

        <div class="mt-8 flex flex-nowrap justify-center gap-3 sm:gap-4">
          <a
            href="/#productos"
            class="flex-1 rounded-full bg-oscuro px-5 py-3.5 text-center text-sm font-semibold whitespace-nowrap text-white shadow-suave transition-transform hover:-translate-y-0.5 sm:flex-initial sm:px-7"
          >
            Ver productos
          </a>
          <a
            href="/#nosotros"
            class="flex-1 rounded-full border border-oscuro/80 bg-white/70 px-5 py-3.5 text-center text-sm font-semibold whitespace-nowrap text-black transition-transform hover:-translate-y-0.5 sm:flex-initial sm:px-7"
          >
            Conócenos
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Fundido inferior hacia el color de la sección siguiente (sin costura). -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-32"
    style="background:linear-gradient(180deg,rgba(242,240,254,0) 0%,var(--color-lila-claro) 100%)"
    aria-hidden="true"
  >
  </div>

  <!-- Cinta ondulada al cierre de Inicio (React Bits: TextLoop). -->
  <div class="relative z-10 mt-6 pb-8">
    <TextLoop client:load text="Pequeños detalles, grandes historias" />
  </div>
</section>
