---
import { cld, cldSrcset } from '../lib/cloudinary';
import { whatsappLink } from '../data/site';
import GradientText from './reactbits/GradientText.tsx';
import TextLoop from './reactbits/TextLoop.tsx';
import { GRAD_COOL, GRAD_WARM, GRAD_DIRECTION } from '../data/gradients';

const hero = 'impresora-banner-home.png';
---

<section id="inicio" class="section-blend relative overflow-hidden [--sec-from:var(--color-rosa)] [--sec-to:var(--color-celeste)]">
  <div id="inicio-main" class="relative">
  <!-- Contenido centrado en el contenedor del sitio -->
  <div class="mx-auto max-w-sitio px-5 pt-28 pb-16 md:flex md:min-h-140 md:items-center md:px-8 md:pt-32 md:pb-24 lg:min-h-170">
    <div class="min-w-0 md:max-w-1/2 lg:max-w-[54%]">
      <h1
        data-fit-title
        class="font-display whitespace-nowrap text-5xl leading-[1.1] sm:text-7xl lg:text-7xl xl:text-8xl 3xl:text-[6.5rem]"
      >
        <span class="sr-only">Papelería Creativa</span>
        <GradientText colors={GRAD_COOL} direction={GRAD_DIRECTION} aria-hidden="true">Papeleria</GradientText>{' '}<GradientText colors={GRAD_WARM} direction={GRAD_DIRECTION} aria-hidden="true">Creativa</GradientText>
      </h1>
      <p class="mt-4 text-base font-semibold tracking-[0.2em] text-tinta uppercase sm:text-lg">
        Hecha para recordar
      </p>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinta">
        Diseñamos e imprimimos piezas personalizadas, recuerdos, fotografías,
        invitaciones y proyectos en papel que transforman una idea en algo que
        puedes tocar, guardar y regalar.
      </p>
      <div class="mt-8 flex flex-nowrap gap-3 sm:gap-4">
        <a
          href="/#proyectos"
          class="flex-1 rounded-full bg-oscuro px-4 py-3.5 text-center text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5 sm:flex-initial sm:px-7"
        >
          Explorar nuestros trabajos
        </a>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener"
          class="flex-1 rounded-full border border-oscuro/80 bg-white/60 px-4 py-3.5 text-center text-sm font-semibold text-tinta transition-transform hover:-translate-y-0.5 sm:flex-initial sm:px-7"
        >
          Cotizar un proyecto
        </a>
      </div>
    </div>
  </div>

  <!-- Imagen a tope del borde derecho (solo desktop); oculta en móvil -->
  <img
    id="hero-img"
    data-parallax="0.09"
    src={cld(hero, 720)}
    srcset={cldSrcset(hero, [480, 720, 1082])}
    sizes="46vw"
    width="1082"
    height="1174"
    alt="Herramientas de papelería creativa: impresora fotográfica, máquina de chapas y plotter de corte en tonos pastel"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hidden will-change-transform md:absolute md:right-0 md:top-1/2 md:mx-0 md:block md:w-[46vw] md:max-w-110 md:-translate-y-1/2 lg:w-[42vw] lg:max-w-160"
  />
  </div>

  <!-- Espacio transparente para conservar el fundido rosa a celeste. -->
  <div class="relative mt-6 pb-8">
    <TextLoop client:load text="Papelería creativa ✦ Hecha para recordar" />
  </div>
</section>

<script>
  // La imagen del hero solo existe en desktop (hidden md:block), por lo que no
  // se requiere lógica de parallax para móvil. En desktop las clases de Tailwind
  // (md:-translate-y-1/2) controlan el centrado vertical.
</script>
