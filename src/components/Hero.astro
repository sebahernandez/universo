---
import { cld, cldSrcset } from '../lib/cloudinary';
import { whatsappLink } from '../data/site';

const hero = 'impresora-banner-home.png';
---

<section id="inicio" class="section-blend relative overflow-hidden [--sec-from:var(--color-rosa)] [--sec-to:var(--color-celeste)]">
  <!-- Contenido centrado en el contenedor del sitio -->
  <div class="mx-auto max-w-sitio px-5 py-16 md:flex md:min-h-[560px] md:items-center md:px-8 md:py-24 lg:min-h-[680px]">
    <div class="min-w-0 md:max-w-[50%] lg:max-w-[54%]">
      <h1
        data-fit-title
        class="font-display whitespace-nowrap text-5xl leading-[1.02] sm:text-7xl lg:text-7xl xl:text-8xl min-[1440px]:text-[6.5rem]"
      >
        <span class="sr-only">Papelería Creativa</span>
        <span class="mr-[0.3em] text-grad-cool" aria-hidden="true">Papeleria</span>{' '}<span class="text-grad-warm" aria-hidden="true">Creativa</span>
      </h1>
      <p class="mt-4 text-base font-semibold tracking-[0.2em] text-tinta uppercase sm:text-lg">
        Hecha para recordar
      </p>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinta">
        Diseñamos e imprimimos piezas personalizadas, recuerdos, fotografías,
        invitaciones y proyectos en papel que transforman una idea en algo que
        puedes tocar, guardar y regalar.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/#proyectos"
          class="rounded-full bg-oscuro px-7 py-3.5 text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5"
        >
          Explorar nuestros trabajos
        </a>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-oscuro/80 bg-white/60 px-7 py-3.5 text-sm font-semibold text-tinta transition-transform hover:-translate-y-0.5"
        >
          Cotizar un proyecto
        </a>
      </div>
    </div>
  </div>

  <!-- Imagen a tope del borde derecho (desktop); apilada bajo el texto en móvil -->
  <img
    id="hero-img"
    data-parallax="0.09"
    src={cld(hero, 720)}
    srcset={cldSrcset(hero, [480, 720, 1082])}
    sizes="(max-width: 767px) 85vw, (max-width: 1023px) 46vw, 42vw"
    width="1082"
    height="1174"
    alt="Herramientas de papelería creativa: impresora fotográfica, máquina de chapas y plotter de corte en tonos pastel"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="-mt-4 w-full max-w-none pb-16 will-change-transform md:absolute md:right-0 md:top-1/2 md:mx-0 md:mt-0 md:w-[46vw] md:max-w-[440px] md:-translate-y-1/2 md:pb-0 lg:w-[42vw] lg:max-w-[640px]"
  />
</section>

<script>
  const heroSection = document.getElementById('inicio');
  const heroImg = document.getElementById('hero-img');
  const heroReduce = matchMedia('(prefers-reduced-motion: reduce)');
  // Solo en móvil: en desktop la imagen usa su propio transform de centrado.
  const heroMobile = matchMedia('(max-width: 767px)');

  if (heroSection && heroImg && !heroReduce.matches) {
    const speed = parseFloat(heroImg.dataset.parallax || '0');
    let ticking = false;

    function update() {
      if (heroMobile.matches) {
        const rect = heroSection!.getBoundingClientRect();
        // 0 cuando el centro de la sección coincide con el centro del viewport
        const progress = rect.top + rect.height / 2 - window.innerHeight / 2;
        heroImg!.style.transform = `translate3d(0, ${(progress * speed).toFixed(1)}px, 0)`;
      } else {
        // Deja que las clases de Tailwind (md:-translate-y-1/2) controlen el desktop
        heroImg!.style.transform = '';
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
