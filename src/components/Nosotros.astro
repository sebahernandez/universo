  <!-- Ancla adicional para el enlace del Footer (/#quienes-somos), que no se modifica. -->
  <span id="quienes-somos" class="block"></span>
  <div class="mx-auto max-w-3xl px-5 py-14 text-center md:px-8 md:py-20">
    <h2 class="font-display text-4xl leading-[1.1] text-tinta sm:text-5xl">
