---
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import { cld, cldSrcset } from '../lib/cloudinary';

// Anclas absolutas (/#seccion) para que funcionen desde páginas internas.
const explorar = [
  { label: 'Servicios', href: '/#que-podemos-hacer' },
  { label: 'Proyectos', href: '/#proyectos' },
  { label: 'Nosotros', href: '/#quienes-somos' },
  { label: 'Envíos', href: '/#compras-envios' },
];
const ayuda = [
  { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
  { label: 'Política de cookies', href: '/politica-cookies' },
  { label: 'Términos y condiciones', href: '/terminos-condiciones' },
];
---

<footer class="bg-[linear-gradient(90deg,#fdf0f5_0%,#fcf5fa_22%,#f4f5fc_50%,#e9f3fb_66%,#ece4fb_100%)]">
  <div class="mx-auto grid max-w-sitio gap-10 px-5 py-14 md:grid-cols-2 md:px-8 lg:grid-cols-6">
    <div class="lg:col-span-2">
      <img
        src={cld('logo-universo-crafter.png', 240)}
        srcset={cldSrcset('logo-universo-crafter.png', [180, 240, 396])}
        width="396"
        height="188"
        alt="Universo Crafter"
        loading="lazy"
        class="h-14 w-auto"
      />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-tinta-suave">{site.tagline}</p>
    </div>

    <div>
      <h3 class="text-sm font-bold text-tinta">Explorar</h3>
      <ul class="mt-4 space-y-2 text-sm text-tinta-suave">
        {explorar.map((l) => (
          <li><a href={l.href} class="transition-colors hover:text-rosa-fuerte">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold text-tinta">Ayuda</h3>
      <ul class="mt-4 space-y-2 text-sm text-tinta-suave">
        {ayuda.map((l) => (
          <li><a href={l.href} class="transition-colors hover:text-rosa-fuerte">{l.label}</a></li>
        ))}
        <li>
          <button
            type="button"
            onclick="window.ucConsent && window.ucConsent.open()"
            class="text-left transition-colors hover:text-rosa-fuerte"
          >
            Preferencias de cookies
          </button>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold text-tinta">Síguenos</h3>
      <div class="mt-4 flex gap-3 text-tinta-suave">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-rosa-fuerte"><SocialIcon name="instagram" /></a>
        <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-celeste-fuerte"><SocialIcon name="facebook" /></a>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-bold text-tinta">Contacto</h3>
      <a href={`mailto:${site.email}`} class="mt-4 block text-sm text-tinta-suave hover:text-rosa-fuerte">{site.email}</a>
      <address class="mt-2 text-sm leading-relaxed text-tinta-suave not-italic">
        <span class="whitespace-nowrap">Santiago, Región Metropolitana.</span> Tienda online.<br />
        Universo Crafter SpA.
      </address>
    </div>
  </div>

  <div class="border-t border-white/50">
    <p class="mx-auto max-w-sitio px-5 py-6 text-center text-xs text-tinta-suave md:px-8">
      © 2026 Universo Crafter. Sitio creado por Kreadium SpA.
    </p>
  </div>
</footer>
