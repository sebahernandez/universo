---
import DisplayTitle from './DisplayTitle.astro';
import { pasos } from '../data/content';
import { whatsappLink } from '../data/site';
import { cld } from '../lib/cloudinary';
---

<section class="section-blend relative flex min-h-screen items-center overflow-hidden [--sec-from:var(--color-rosa)] [--sec-to:var(--color-amarillo)]">
  <!-- Formas decorativas en las esquinas (mismas figuras de la referencia) -->
  <!-- Esquina superior derecha: blob amarillo con puntitos (misma figura, en amarillo) -->
  <svg
    class="pointer-events-none absolute -right-8 -top-6 z-0 h-52 w-72 md:h-64 md:w-96"
    viewBox="0 0 200 150"
    fill="none"
    aria-hidden="true"
  >
    <g transform="rotate(180 100 75)">
      <path
        d="M0,52C24,40,52,44,68,58C80,68,88,52,106,47C134,39,160,55,168,84C174,106,160,128,132,136C96,146,46,148,0,148Z"
        fill="#f9e8ab"></path>
      <circle cx="150" cy="30" r="7.5" fill="#f2cf63"></circle>
      <circle cx="172" cy="18" r="4.5" fill="#f2cf63"></circle>
    </g>
  </svg>

  <!-- Esquina inferior izquierda: blob lila con puntitos (figura de referencia) -->
  <svg
    class="pointer-events-none absolute -bottom-6 -left-8 z-0 h-52 w-72 md:h-64 md:w-96"
    viewBox="0 0 200 150"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M0,52C24,40,52,44,68,58C80,68,88,52,106,47C134,39,160,55,168,84C174,106,160,128,132,136C96,146,46,148,0,148Z"
      fill="#e2d2f4"></path>
    <circle cx="150" cy="30" r="7.5" fill="#cdb6ee"></circle>
    <circle cx="172" cy="18" r="4.5" fill="#cdb6ee"></circle>
  </svg>

  <div class="relative z-10 mx-auto w-full max-w-sitio px-5 py-16 md:px-8 md:py-24">
    <DisplayTitle lead="Cómo" accent="Trabajamos" subtitle="Cuidamos cada detalle" class="mb-14" />

    <ol class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        pasos.map((p) => (
          <li class="text-center">
            <img
              src={cld(p.icon, 520)}
              alt=""
              width="256"
              height="256"
              loading="lazy"
              decoding="async"
              class="mx-auto h-52 w-52 object-contain md:h-64 md:w-64"
            />
            <h3 class="-mt-2 text-2xl font-bold text-tinta">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-tinta-suave">{p.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-14 text-center">
      <p class="font-display text-2xl text-lila-fuerte">¿Tienes una idea en mente?</p>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-block rounded-full bg-oscuro px-10 py-4 text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5"
      >
        Cotiza tu proyecto
      </a>
    </div>
  </div>
</section>
