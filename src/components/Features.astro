---
import DisplayTitle from './DisplayTitle.astro';
import { features } from '../data/content';
import { cld } from '../lib/cloudinary';
---

<section class="section-blend [--sec-from:var(--color-lila-claro)] [--sec-to:var(--color-blanco-lila)]">
  <div class="mx-auto max-w-sitio px-5 py-16 md:px-8 md:py-24">
    <DisplayTitle lead="No sólo" accent="Imprimimos" subtitle="Cuidamos cada detalle" class="mb-14" />

    <div class="grid gap-x-6 gap-y-20 pt-16 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <article class="relative rounded-tarjeta border border-tinta/10 bg-white px-7 pb-7 pt-24 text-center shadow-suave sm:text-left">
            <img
              src={cld(f.icon, 416)}
              alt=""
              width="208"
              height="208"
              loading="lazy"
              decoding="async"
              class="absolute -top-28 left-1/2 h-52 w-52 -translate-x-1/2 object-contain drop-shadow-[0_12px_20px_rgb(43_36_54/0.12)]"
            />
            <h3 class="text-lg font-bold text-tinta">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-tinta-suave">{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
