---
import DisplayTitle from './DisplayTitle.astro';
import { servicios } from '../data/content';

const bg = {
  rosa: 'bg-rosa/70',
  amarillo: 'bg-amarillo/70',
  celeste: 'bg-celeste/80',
};
const num = {
  rosa: 'text-rosa-fuerte',
  amarillo: 'text-amarillo-fuerte',
  celeste: 'text-celeste-fuerte',
};
---

<section id="que-podemos-hacer" class="bg-blanco-lila">
  <div class="mx-auto max-w-sitio px-5 py-16 md:px-8 md:py-24">
    <DisplayTitle lead="¿Qué podemos" accent="Hacer?" subtitle="Ideas que se convierten en algo real" class="mb-14" />

    <div class="grid gap-10 md:grid-cols-3">
      {
        servicios.map((s) => (
          <article class="relative">
            {/* Halo de brillo suave detrás de la tarjeta */}
            <div
              class={`pointer-events-none absolute inset-0 rounded-panel ${bg[s.color]} opacity-70 blur-2xl`}
              aria-hidden="true"
            />
            {/* Tarjeta nítida */}
            <div class={`relative rounded-panel ${bg[s.color]} px-8 pb-9 pt-7`}>
              <span class={`block font-display text-7xl leading-none ${num[s.color]}`}>{s.num}</span>
              <h3 class="mt-4 text-xl font-bold text-tinta">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-tinta-suave">{s.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
