---
import InfiniteSpiral from './reactbits/InfiniteSpiral.tsx';
import GradientText from './reactbits/GradientText.tsx';
import { GRAD_COOL, GRAD_WARM, GRAD_DIRECTION } from '../data/gradients';
import { galeria } from '../data/content';
import { cld } from '../lib/cloudinary';

// Imágenes de proyecto para el espiral (mismas de la galería, servidas por Cloudinary).
const spiralItems = galeria.map((item) => ({
  src: cld(item.src, 400),
  alt: item.alt,
}));
---

<section id="proyectos" class="section-blend [--sec-from:var(--color-amarillo)] [--sec-to:var(--color-celeste)]">
  <div class="mx-auto max-w-sitio px-5 py-16 md:px-8 md:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      {/* Columna izquierda: título + subtítulo */}
      <div class="text-center lg:text-left">
        <h2
          data-fit-title
          class="font-display text-[2.75rem] leading-[1.1] sm:text-7xl lg:text-7xl xl:text-8xl min-[1440px]:text-[6.5rem]"
        >
          <GradientText colors={GRAD_COOL} direction={GRAD_DIRECTION}>Nuestros</GradientText>{' '}<GradientText colors={GRAD_WARM} direction={GRAD_DIRECTION}>Proyectos</GradientText>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-tinta lg:mx-0">
          Ideas, procesos, nuevos productos y proyectos que vamos creando día a día.
        </p>
        <div class="mt-6">
          <a
            href="/#contacto"
            class="inline-block rounded-full bg-oscuro px-7 py-3.5 text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5"
          >
            Cotiza tu proyecto
          </a>
        </div>
      </div>

      {/* Columna derecha: espiral infinito de proyectos (auto-animado, sin modal).
         El mask degrada las tarjetas hacia transparente arriba y abajo, para que
         no se vea la línea de corte del contenedor en la transición del fondo. */}
      <div class="spiral-fade relative h-[360px] w-full overflow-hidden sm:h-[460px] lg:h-[560px]">
        <InfiniteSpiral
          client:load
          items={spiralItems}
          cardWidth={110}
          cardHeight={86}
          cardRadius={12}
          radius={158}
          verticalSpacing={90}
          cardsPerTurn={7}
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Desvanecido de los bordes del espiral para que no se vea la línea de corte
     del contenedor. En móvil se difuminan los 4 lados (el espiral ocupa todo el
     ancho y se corta a los lados); en escritorio basta arriba y abajo. */
  .spiral-fade {
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-composite: intersect;
  }

  @media (min-width: 1024px) {
    .spiral-fade {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
    }
  }
</style>
