---
import { navLinks, site, whatsappLink } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import { cld, cldSrcset } from '../lib/cloudinary';

const logo = 'logo-universo-crafter.png';

// Colores pastel de la marca, uno por enlace (ciclan si hay más enlaces).
const accents = [
  { soft: '#fce4ec', strong: '#f7a8c4' }, // rosa
  { soft: '#e3f4fd', strong: '#9fd8f2' }, // celeste
  { soft: '#d9f5ec', strong: '#8fe0c4' }, // menta
  { soft: '#ece4fb', strong: '#b9a7f0' }, // lila
  { soft: '#fdf3cf', strong: '#f6d36b' }, // amarillo
];
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 px-4 pt-3 md:px-6 md:pt-4"
  data-scrolled="false"
>
  <!-- Fondo tenue detrás del menú flotante (móvil) -->
  <div
    id="menu-backdrop"
    class="menu-backdrop fixed inset-0 -z-10 bg-tinta/25 backdrop-blur-[2px] lg:hidden"
    data-open="false"
    aria-hidden="true"
  >
  </div>
  <nav
    class="site-nav mx-auto flex max-w-sitio items-center justify-between gap-4 rounded-[1.75rem] px-5 py-2.5 md:px-6 md:py-3"
    aria-label="Navegación principal"
  >
    <a href="/#inicio" aria-label="Universo Crafter — inicio" class="shrink-0">
      <img
        src={cld(logo, 400)}
        srcset={cldSrcset(logo, [280, 400, 560])}
        width="396"
        height="188"
        alt="Universo Crafter"
        class="h-12 w-auto md:h-14"
        loading="eager"
      />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link relative text-sm font-bold tracking-wide text-tinta uppercase transition-colors hover:text-rosa-fuerte"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        aria-label="Escríbenos por WhatsApp"
        class="social-chip hover:text-menta-fuerte"
      >
        <SocialIcon name="whatsapp" class="h-[1.05rem] w-[1.05rem]" />
      </a>
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener"
        aria-label="Síguenos en Instagram"
        class="social-chip hover:text-rosa-fuerte"
      >
        <SocialIcon name="instagram" class="h-[1.05rem] w-[1.05rem]" />
      </a>
      <a
        href={site.facebook}
        target="_blank"
        rel="noopener"
        aria-label="Síguenos en Facebook"
        class="social-chip hover:text-celeste-fuerte"
      >
        <SocialIcon name="facebook" class="h-[1.05rem] w-[1.05rem]" />
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="menu-toggle ml-1 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white/70 text-tinta shadow-suave backdrop-blur-sm transition-colors hover:bg-white lg:hidden"
      >
        <span class="menu-icon" aria-hidden="true">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </span>
      </button>
    </div>
  </nav>

  <!-- Menú móvil flotante (no desplaza el contenido) -->
  <div
    id="mobile-menu"
    class="mobile-menu absolute inset-x-4 top-full z-40 md:inset-x-6 lg:hidden"
    data-open="false"
  >
    <div class="mobile-menu__inner">
      <div
        class="mt-2 rounded-3xl border border-white/50 bg-[linear-gradient(160deg,#fdf0f5_0%,#f4f5fc_50%,#ece4fb_100%)] px-5 pb-7 pt-4 shadow-[0_24px_40px_-16px_rgb(43_36_54/0.35)]"
      >
        <ul class="flex flex-col gap-2.5">
          {
            navLinks.map((link, i) => {
              const c = accents[i % accents.length];
              return (
                <li class="menu-item" style={`--i:${i}`}>
                  <a
                    href={link.href}
                    class="mobile-link group flex min-h-13 items-center gap-3.5 rounded-2xl px-4 py-3 shadow-suave transition-transform duration-200 active:translate-x-0.5"
                    style={`background:${c.soft}`}
                  >
                    <span
                      class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/70"
                    >
                      <span
                        class="h-2.5 w-2.5 rounded-full"
                        style={`background:${c.strong}`}
                      />
                    </span>
                    <span class="text-lg font-semibold text-tinta">
                      {link.label}
                    </span>
                    <svg
                      class="ml-auto h-5 w-5 shrink-0 text-tinta/40 transition-transform duration-200 group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                    </svg>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <!-- CTA WhatsApp + redes -->
        <div class="menu-item mt-4 flex items-center gap-3" style={`--i:${navLinks.length}`}>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener"
            class="flex min-h-13 flex-1 items-center justify-center gap-2.5 rounded-2xl bg-oscuro px-5 py-3.5 text-base font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5"
          >
            <SocialIcon name="whatsapp" />
            Escríbenos por WhatsApp
          </a>
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Síguenos en Instagram"
            class="grid h-13 w-13 shrink-0 place-items-center rounded-2xl bg-white/70 text-tinta-suave shadow-suave transition-colors hover:text-rosa-fuerte"
          >
            <SocialIcon name="instagram" />
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* ---- Menú flotante estilo glass: una isla con esquinas curvadas que
         sólo abarca al menú y deja ver el Hero (a tope arriba) por detrás ---- */
  .site-nav {
    background: rgb(255 255 255 / 0.5);
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow: 0 8px 30px -10px rgb(43 36 54 / 0.18);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease,
      backdrop-filter 0.4s ease;
  }
  /* Al bajar del Hero: la isla se vuelve un poco más opaca y con más sombra. */
  .site-header[data-scrolled='true'] .site-nav {
    background: rgb(255 255 255 / 0.68);
    box-shadow: 0 14px 40px -12px rgb(43 36 54 / 0.28);
  }
  /* Sin soporte de backdrop-filter: subir opacidad para no perder contraste. */
  @supports not (backdrop-filter: blur(1px)) {
    .site-nav {
      background: rgb(255 255 255 / 0.9);
    }
    .site-header[data-scrolled='true'] .site-nav {
      background: rgb(255 255 255 / 0.95);
    }
  }

  /* ---- Subrayado animado de los enlaces de escritorio ---- */
  .nav-link {
    padding-bottom: 2px;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--color-rosa-fuerte);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ---- Chips de redes sociales: círculos de vidrio que combinan con la isla,
         con color de marca y leve elevación al pasar el cursor ---- */
  .social-chip {
    display: none;
  }
  @media (min-width: 640px) {
    .social-chip {
      display: inline-grid;
      place-items: center;
      height: 2.25rem;
      width: 2.25rem;
      border-radius: 9999px;
      color: var(--color-tinta-suave);
      background: rgb(255 255 255 / 0.5);
      border: 1px solid rgb(255 255 255 / 0.6);
      box-shadow: 0 6px 16px -8px rgb(43 36 54 / 0.2);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transition:
        color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }
    .social-chip:hover {
      background: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 20px -8px rgb(43 36 54 / 0.28);
    }
    .social-chip:focus-visible {
      outline: 2px solid var(--color-rosa-fuerte);
      outline-offset: 2px;
    }
  }

  /* ---- Botón hamburguesa que se transforma en X ---- */
  .menu-icon {
    display: grid;
    gap: 5px;
    width: 22px;
  }
  .menu-bar {
    display: block;
    height: 2px;
    width: 22px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }
  /* Al abrir: la barra central desaparece y las otras dos forman una X
     centrada y simétrica (gap 5px + barra 2px => desplazamiento de 7px). */
  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Panel que se despliega suavemente (altura + fade) ---- */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.35s ease,
      opacity 0.3s ease;
  }
  .mobile-menu[data-open='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .mobile-menu__inner {
    overflow: hidden;
    min-height: 0;
  }

  /* ---- Entrada escalonada de cada elemento ---- */
  .menu-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }

  /* ---- Fondo tenue detrás del menú flotante ---- */
  .menu-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .menu-backdrop[data-open='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-item,
    .menu-bar,
    .menu-backdrop,
    .site-nav,
    .social-chip,
    .nav-link::after {
      transition-duration: 0.01ms;
    }
    .menu-item {
      transition-delay: 0ms;
    }
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  const hero = document.getElementById('inicio');

  // Alterna data-scrolled cuando el Hero deja de asomar bajo el header,
  // para pasar del fondo transparente al fondo esmerilado.
  if (siteHeader && hero) {
    let observer: IntersectionObserver | null = null;

    function observeHero() {
      observer?.disconnect();
      observer = new IntersectionObserver(
        ([entry]) => {
          siteHeader!.setAttribute('data-scrolled', String(!entry.isIntersecting));
        },
        { rootMargin: `-${siteHeader!.offsetHeight}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(hero);
    }

    observeHero();

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(observeHero, 150);
    });
  }

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('menu-backdrop');

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.setAttribute('data-open', String(open));
    backdrop?.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.getAttribute('data-open') !== 'true');
  });

  // Cerrar al tocar el fondo tenue
  backdrop?.addEventListener('click', () => setOpen(false));

  // Cerrar al elegir un enlace del menú
  menu?.querySelectorAll('.mobile-link').forEach((el) =>
    el.addEventListener('click', () => setOpen(false)),
  );

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.getAttribute('data-open') === 'true') setOpen(false);
  });

  // Cerrar al tocar fuera del header
  document.addEventListener('click', (e) => {
    if (menu?.getAttribute('data-open') !== 'true') return;
    const header = toggle?.closest('header');
    if (header && !header.contains(e.target as Node)) setOpen(false);
  });
</script>
