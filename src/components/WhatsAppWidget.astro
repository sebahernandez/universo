---
// Widget flotante de contacto por WhatsApp (esquina inferior derecha).
// Réplica del patrón "chat launcher" con la marca Universo Crafter.
import { site, whatsappLink } from '../data/site';
---

<div
  class="wa-widget fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3 print:hidden sm:bottom-6 sm:right-6"
>
  <!-- Panel / burbuja de chat -->
  <div
    id="wa-panel"
    role="dialog"
    aria-label={`Chatea con ${site.name}`}
    aria-hidden="true"
    class="wa-panel pointer-events-none w-[19rem] origin-bottom-right translate-y-2 scale-95 opacity-0 sm:w-[21rem]"
  >
    <div
      class="relative rounded-panel border border-tinta/5 bg-white p-5 shadow-[0_24px_60px_-18px_rgb(43_36_54/0.35)]"
    >
      <!-- Encabezado: avatar + saludo -->
      <div class="mb-4 flex items-start gap-3">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-menta text-oscuro shadow-sm"
          aria-hidden="true"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 10h8M8 14h5m-9 6 3.2-2.4A2 2 0 0 1 8.4 17H17a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v12Z"
            />
          </svg>
        </span>
        <p class="pt-0.5 text-[0.95rem] font-semibold leading-snug text-tinta">
          ¡Hola! ¿Tienes una idea o proyecto en mente? Escríbenos y lo llevamos al papel ✨
        </p>
      </div>

      <!-- CTA principal -->
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        class="group flex cursor-pointer items-center gap-3 rounded-2xl bg-oscuro px-4 py-3.5 text-white transition-transform hover:-translate-y-0.5"
      >
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-menta-fuerte text-oscuro"
          aria-hidden="true"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"
            />
          </svg>
        </span>
        <span class="flex-1 text-[0.95rem] font-semibold">Chatea con nosotros</span>
        <svg class="h-4 w-4 shrink-0 opacity-80 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" />
        </svg>
      </a>

      <!-- Firma de marca -->
      <p class="mt-3 text-center text-xs font-medium text-tinta-suave">
        Escríbenos por <span class="font-semibold text-tinta">{site.name}</span>
      </p>

      <!-- Colita de la burbuja apuntando al botón -->
      <span
        class="absolute -bottom-1.5 right-8 h-4 w-4 rotate-45 rounded-br-[3px] border-b border-r border-tinta/5 bg-white"
        aria-hidden="true"
      ></span>
    </div>
  </div>

  <!-- Botón flotante (FAB) -->
  <button
    id="wa-toggle"
    type="button"
    aria-label="Abrir chat de WhatsApp"
    aria-expanded="false"
    aria-controls="wa-panel"
    class="wa-fab flex h-14 w-14 cursor-pointer items-center justify-center rounded-full bg-menta-fuerte text-oscuro shadow-[0_12px_28px_-8px_rgb(143_224_196/0.9)] outline-none transition-transform hover:-translate-y-0.5 focus-visible:ring-4 focus-visible:ring-menta"
  >
    <!-- Icono WhatsApp (estado cerrado) -->
    <svg class="wa-icon-open h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"
      />
    </svg>
    <!-- Chevron abajo (estado abierto) -->
    <svg class="wa-icon-close hidden h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
    </svg>
  </button>
</div>

<style>
  .wa-panel {
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .wa-widget[data-open='true'] .wa-panel {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-panel,
    .wa-fab,
    .wa-fab:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const widget = document.querySelector<HTMLElement>('.wa-widget');
  const toggle = document.getElementById('wa-toggle');
  const panel = document.getElementById('wa-panel');
  const iconOpen = widget?.querySelector<HTMLElement>('.wa-icon-open');
  const iconClose = widget?.querySelector<HTMLElement>('.wa-icon-close');

  function setOpen(open: boolean) {
    if (!widget || !toggle || !panel) return;
    widget.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar chat de WhatsApp' : 'Abrir chat de WhatsApp');
    panel.setAttribute('aria-hidden', String(!open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(widget?.dataset.open !== 'true');
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget?.dataset.open === 'true') {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Cerrar al hacer clic fuera del widget
  document.addEventListener('click', (e) => {
    if (widget?.dataset.open === 'true' && !widget.contains(e.target as Node)) {
      setOpen(false);
    }
  });
</script>
