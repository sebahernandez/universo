---
import DisplayTitle from './DisplayTitle.astro';
import { comoComprar, comoRecibes } from '../data/content';
import { cld } from '../lib/cloudinary';

const panels = [
  {
    title: 'Cómo comprar',
    subtitle: 'Elige la forma que más te acomode',
    cards: comoComprar,
    bg: 'bg-rosa/50',
  },
  {
    title: 'Cómo recibes tu pedido',
    subtitle: 'Tú eliges, nosotros te acompañamos',
    cards: comoRecibes,
    bg: 'bg-celeste/60',
  },
];
---

<section id="compras-envios" class="bg-celeste">
  <div class="mx-auto max-w-sitio px-5 py-16 md:px-8 md:py-24">
    <DisplayTitle lead="Compras y" accent="Envíos" subtitle="Llegamos a todo Chile" class="mb-14" />

    <div class="grid gap-6 lg:grid-cols-2">
      {
        panels.map((panel) => (
          <div class={`rounded-panel ${panel.bg} p-6 md:p-8`}>
            <h3 class="text-center font-display text-3xl text-tinta">{panel.title}</h3>
            <p class="mt-1 text-center text-xs font-semibold tracking-[0.15em] text-tinta-suave uppercase">
              {panel.subtitle}
            </p>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              {panel.cards.map((c) => (
                <article class="rounded-tarjeta bg-white/85 p-6 shadow-suave">
                  <img src={cld(c.icon, 240)} alt="" width="112" height="112" loading="lazy" decoding="async" class="mx-auto h-24 w-24 object-contain md:h-28 md:w-28" />
                  <h4 class="mt-4 text-base font-bold text-tinta">{c.title}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-tinta-suave" set:html={c.text} />
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
