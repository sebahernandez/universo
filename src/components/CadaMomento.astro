---
// Sección combinada: a la izquierda la tarjeta "Papelería para cada momento"
// (imagen de fondo con texto superpuesto) y a la derecha los testimonios.
// En móvil se apilan (tarjeta arriba, testimonios abajo); en escritorio van
// lado a lado (grid de 2 columnas).
import { cld, cldSrcset } from '../lib/cloudinary';
import { testimonios } from '../data/testimonios';

const imgMovil =
  'https://res.cloudinary.com/v5ovpy2d/image/upload/v1791167451/cada-momento-universocrafter-movil.avif';
const imgDesktop =
  'https://res.cloudinary.com/v5ovpy2d/image/upload/v1791168136/cada-momento-universocrafter-desktop.avif';
---

<section class="section-blend [--sec-from:var(--color-celeste)] [--sec-to:var(--color-blanco-lila)]">
  <div class="mx-auto max-w-sitio px-5 py-12 md:px-8 md:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-10">
      <!-- Tarjeta "Papelería para cada momento" -->
      <div class="relative min-h-[24rem] overflow-hidden rounded-panel shadow-suave sm:min-h-[26rem]">
        <!-- Imagen de fondo: vertical en móvil, horizontal en escritorio -->
        <img
          src={cld(imgMovil, 800)}
          srcset={cldSrcset(imgMovil, [400, 600, 800])}
          sizes="(min-width: 768px) 50vw, 90vw"
          width="800"
          height="1000"
          alt="Papelería creativa en tonos pastel: cuadernos, washi tapes y stickers"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover md:hidden"
        />
        <img
          src={cld(imgDesktop, 1200)}
          srcset={cldSrcset(imgDesktop, [600, 900, 1200])}
          sizes="50vw"
          width="1200"
          height="800"
          alt="Papelería creativa en tonos pastel: cuadernos, washi tapes y stickers"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 hidden h-full w-full object-cover md:block"
        />

        <!-- Velo de legibilidad: centro en móvil, lado derecho en escritorio -->
        <div
          class="absolute inset-0 md:hidden"
          style="background:radial-gradient(70% 45% at 50% 52%,rgba(255,255,255,0.72) 0%,rgba(255,255,255,0.3) 55%,rgba(255,255,255,0) 100%)"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 hidden md:block"
          style="background:linear-gradient(270deg,rgba(255,255,255,0.78) 0%,rgba(255,255,255,0.45) 32%,rgba(255,255,255,0) 62%)"
          aria-hidden="true"
        >
        </div>

        <!-- Contenido: centrado en móvil, a la derecha en escritorio -->
        <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center md:items-end md:justify-center md:pr-[7%] md:text-right">
          <h2 class="font-display text-4xl leading-[1.1] text-tinta sm:text-5xl">
            Papelería <span class="text-rosa-fuerte">para cada momento</span>
          </h2>
          <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed font-medium text-tinta sm:text-base md:mx-0">
            Organiza, crea y regala con productos pensados para inspirarte.
          </p>
          <a
            href="/#productos"
            class="mt-5 inline-block rounded-full bg-oscuro px-7 py-3 text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5"
          >
            Ver colección
          </a>
        </div>
      </div>

      <!-- Testimonios -->
      <div>
        <h2 class="text-center font-display text-4xl leading-[1.1] text-tinta sm:text-5xl">
          Lo que dicen <span class="text-rosa-fuerte">nuestras clientas</span>
        </h2>

        <div class="relative mx-auto mt-6 max-w-xl" data-testi-carousel>
          <div class="rounded-panel bg-white/85 p-6 shadow-suave sm:p-8">
            {
              testimonios.map((t, i) => (
                <figure class="testi-slide" data-testi-slide hidden={i !== 0}>
                  <img
                    src={t.avatar}
                    width="72"
                    height="72"
                    alt={`Foto de ${t.autora}`}
                    loading="lazy"
                    decoding="async"
                    class="mx-auto mb-4 h-[72px] w-[72px] rounded-full object-cover ring-4 ring-white shadow-suave"
                  />
                  <div class="flex justify-center gap-1" aria-label={`${t.estrellas} de 5 estrellas`}>
                    {Array.from({ length: 5 }).map((_, s) => (
                      <svg
                        class={s < t.estrellas ? 'h-5 w-5 text-amarillo-fuerte' : 'h-5 w-5 text-tinta/15'}
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 18.9 6.1 20.3l1.3-6.5L2.5 9.3l6.6-.8L12 2.5z" />
                      </svg>
                    ))}
                  </div>
                  <blockquote class="mt-4 text-center text-base leading-relaxed text-tinta sm:text-lg">
                    “{t.texto}”
                  </blockquote>
                  <figcaption class="mt-4 text-center text-sm font-semibold text-tinta-suave">
                    {t.autora}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          {
            testimonios.length > 1 && (
              <div class="mt-5 flex items-center justify-center gap-4">
                <button
                  type="button"
                  data-testi-prev
                  aria-label="Testimonio anterior"
                  class="grid h-10 w-10 place-items-center rounded-full bg-white text-tinta shadow-suave transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rosa-fuerte"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6" />
                  </svg>
                </button>

                <div class="flex gap-2">
                  {testimonios.map((_, i) => (
                    <button
                      type="button"
                      data-testi-dot
                      aria-label={`Ir al testimonio ${i + 1}`}
                      aria-current={i === 0 ? 'true' : 'false'}
                      class="h-2.5 w-2.5 rounded-full bg-tinta/20 transition-colors aria-[current=true]:bg-rosa-fuerte"
                    />
                  ))}
                </div>

                <button
                  type="button"
                  data-testi-next
                  aria-label="Testimonio siguiente"
                  class="grid h-10 w-10 place-items-center rounded-full bg-white text-tinta shadow-suave transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rosa-fuerte"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                  </svg>
                </button>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-testi-carousel]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-testi-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-testi-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-testi-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-testi-next]');
    let idx = 0;

    function show(n: number) {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== idx));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === idx)));
    }

    prev?.addEventListener('click', () => show(idx - 1));
    next?.addEventListener('click', () => show(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    show(0);
  }
</script>
