---
import { productos, categorias } from '../data/productos';
import { cld, cldSrcset } from '../lib/cloudinary';

const tabs = ['Todos', ...categorias];
---

<section id="productos" class="section-blend [--sec-from:var(--color-blanco-lila)] [--sec-to:var(--color-lila-claro)]">
  <!-- Anclas equivalentes para enlaces del Footer (no se modifica el Footer). -->
  <span id="proyectos" class="block"></span>
  <span id="que-podemos-hacer" class="block"></span>
  <div class="mx-auto max-w-sitio px-5 py-14 md:px-8 md:py-20" data-productos>
    <h2 class="text-center font-display text-4xl leading-[1.1] text-tinta sm:text-5xl">
      Nuestros <span class="text-rosa-fuerte">Productos</span>
    </h2>
    <p class="mx-auto mt-3 max-w-md text-center text-base text-tinta-suave">
      Papelería creativa, stickers, cuadernos y más para inspirarte todos los días.
    </p>

    <!-- Pestañas de categoría -->
    <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filtrar productos por categoría">
      {
        tabs.map((t) => (
          <button
            type="button"
            data-cat={t === 'Todos' ? 'todos' : t}
            aria-pressed={t === 'Todos' ? 'true' : 'false'}
            class="rounded-full border border-tinta/10 bg-white px-4 py-2 text-sm font-semibold text-tinta shadow-suave transition-colors aria-[pressed=true]:border-oscuro aria-[pressed=true]:bg-oscuro aria-[pressed=true]:text-white"
          >
            {t}
          </button>
        ))
      }
    </div>

    <!-- Tarjetas -->
    <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
      {
        productos.map((p) => (
          <a
            href="/#contacto"
            data-categoria={p.categoria}
            class="group flex flex-col overflow-hidden rounded-tarjeta border border-tinta/10 bg-white shadow-suave transition-transform hover:-translate-y-0.5"
          >
            <img
              src={cld(p.src, 480)}
              srcset={cldSrcset(p.src, [240, 360, 480])}
              sizes="(min-width: 1024px) 22vw, 44vw"
              width="480"
              height="480"
              alt={p.alt}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full object-cover"
            />
            <div class="flex items-end justify-between gap-2 p-4">
              <div class="min-w-0">
                <h3 class="truncate text-sm font-bold text-tinta sm:text-base">{p.nombre}</h3>
                <p class="mt-0.5 text-xs text-tinta-suave">{p.categoria}</p>
              </div>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-rosa text-rosa-fuerte transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="/#contacto"
        class="inline-block rounded-full bg-oscuro px-8 py-4 text-sm font-semibold text-white shadow-suave transition-transform hover:-translate-y-0.5"
      >
        Ver todos los productos
      </a>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-productos]');
  if (section) {
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-categoria]'));

    function filter(cat: string) {
      cards.forEach((c) => {
        c.hidden = !(cat === 'todos' || c.dataset.categoria === cat);
      });
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.cat === cat)));
    }

    tabs.forEach((t) => t.addEventListener('click', () => filter(t.dataset.cat || 'todos')));
    filter('todos');
  }
</script>
