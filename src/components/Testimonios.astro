---
// Testimonios de clientas: carrusel centrado.
import { testimonios } from '../data/testimonios';
import Resaltado from './Resaltado.astro';
---

<section class="section-blend [--sec-from:var(--color-blanco-lila)] [--sec-to:var(--color-lila-claro)]">
  <div class="mx-auto max-w-sitio px-5 py-12 md:px-8 md:py-16">
      <div>
        <h2 data-motion="pegar" class="text-center font-titulo font-semibold tracking-tight text-4xl leading-[1.1] text-tinta sm:text-5xl">
          Lo que dicen <Resaltado>nuestras clientas</Resaltado>
        </h2>

        <div class="relative mx-auto mt-6 max-w-xl touch-pan-y" data-testi-carousel>
          <div class="grid overflow-hidden rounded-panel bg-white/85 p-6 shadow-suave sm:p-8">
            {
              testimonios.map((t, i) => (
                <figure class="testi-slide [grid-area:1/1]" data-testi-slide hidden={i !== 0}>
                  <img
                    src={t.avatar}
                    width="72"
                    height="72"
                    alt={`Foto de ${t.autora}`}
                    loading="lazy"
                    decoding="async"
                    class="mx-auto mb-4 h-[72px] w-[72px] rounded-full object-cover ring-4 ring-white shadow-suave"
                  />
                  <div class="flex justify-center gap-1" aria-label={`${t.estrellas} de 5 estrellas`}>
                    {Array.from({ length: 5 }).map((_, s) => (
                      <svg
                        data-testi-star={s < t.estrellas ? '' : undefined}
                        class={s < t.estrellas ? 'h-5 w-5 text-amarillo-fuerte' : 'h-5 w-5 text-tinta/15'}
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 18.9 6.1 20.3l1.3-6.5L2.5 9.3l6.6-.8L12 2.5z" />
                      </svg>
                    ))}
                  </div>
                  <blockquote class="mt-4 text-center text-base leading-relaxed text-tinta sm:text-lg">
                    “{t.texto}”
                  </blockquote>
                  <figcaption class="mt-4 text-center text-sm font-semibold text-tinta-suave">
                    {t.autora}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          {
            testimonios.length > 1 && (
              <div class="mt-5 flex items-center justify-center gap-4">
                <button
                  type="button"
                  data-testi-prev
                  aria-label="Testimonio anterior"
                  class="grid h-10 w-10 place-items-center rounded-full bg-white text-tinta shadow-suave transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rosa-fuerte"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6" />
                  </svg>
                </button>

                <div class="flex gap-2">
                  {testimonios.map((_, i) => (
                    <button
                      type="button"
                      data-testi-dot
                      aria-label={`Ir al testimonio ${i + 1}`}
                      aria-current={i === 0 ? 'true' : 'false'}
                      class="h-2.5 w-2.5 rounded-full bg-tinta/20 transition-colors aria-[current=true]:bg-rosa-fuerte"
                    />
                  ))}
                </div>

                <button
                  type="button"
                  data-testi-next
                  aria-label="Testimonio siguiente"
                  class="grid h-10 w-10 place-items-center rounded-full bg-white text-tinta shadow-suave transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rosa-fuerte"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                  </svg>
                </button>
              </div>
            )
          }
        </div>
      </div>
  </div>
</section>

<style>
  /* Las láminas inactivas conservan `hidden` pero siguen ocupando su celda de la
     cuadrícula (invisibles y fuera del árbol de accesibilidad): la altura del
     carrusel es la de la lámina más alta y no salta al cambiar de testimonio. */
  .testi-slide[hidden] {
    display: block;
    visibility: hidden;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-testi-carousel]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-testi-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-testi-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-testi-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-testi-next]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let idx = 0;
    let running: gsap.core.Timeline | null = null;

    // A new request first completes the transition in progress, so only one slide is ever left visible.
    function settle() {
      if (running) running.progress(1);
      running = null;
    }

    function show(n: number, dir?: 1 | -1, animate = true) {
      const target = (n + slides.length) % slides.length;
      settle();
      if (target === idx && animate) return;
      const from = slides[idx];
      const to = slides[target];
      const direction = dir ?? (target > idx ? 1 : -1);
      idx = target;
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === idx)));

      if (!animate || reduced.matches || from === to) {
        slides.forEach((s, i) => (s.hidden = i !== idx));
        return;
      }

      to.hidden = false;
      const stars = to.querySelectorAll('[data-testi-star]');
      gsap.killTweensOf(stars);
      running = gsap
        .timeline({
          onComplete: () => {
            from.hidden = true;
            gsap.set([from, to], { clearProps: 'transform,opacity' });
            running = null;
          },
        })
        .to(from, { x: -40 * direction, opacity: 0, duration: 0.28, ease: 'power2.in' }, 0)
        .fromTo(to, { x: 40 * direction, opacity: 0 }, { x: 0, opacity: 1, duration: 0.38, ease: 'power3.out' }, 0.08);
      gsap.fromTo(
        stars,
        { opacity: 0.2, scale: 0.4 },
        { opacity: 1, scale: 1, duration: 0.25, ease: 'back.out(2)', stagger: 0.07, delay: 0.2, clearProps: 'opacity,transform' },
      );
    }

    prev?.addEventListener('click', () => show(idx - 1, -1));
    next?.addEventListener('click', () => show(idx + 1, 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));

    // Swipe: touch/pen only; touch-action: pan-y leaves vertical scrolling to the page (pointercancel).
    let sx = 0;
    let sy = 0;
    let tracking = false;
    root.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      sx = e.clientX;
      sy = e.clientY;
    });
    root.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) show(idx + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });
    root.addEventListener('pointercancel', () => (tracking = false));

    show(0, 1, false);
  }
</script>
