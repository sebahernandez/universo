---
// Acordeón de Preguntas Frecuentes en la home. Reutiliza la MISMA fuente de
// datos (src/data/faq.ts) que /preguntas-frecuentes y el JSON-LD. Se muestra un
// subconjunto; la lista completa vive en /preguntas-frecuentes.
import { faq } from '../data/faq';

const preguntas = faq.slice(0, 6);
---

<section class="section-blend [--sec-from:var(--color-celeste)] [--sec-to:#fdf0f5]">
  <div class="mx-auto max-w-3xl px-5 py-14 md:px-8 md:py-20">
    <h2 class="text-center font-display text-4xl leading-[1.1] text-tinta sm:text-5xl">
      Preguntas <span class="text-rosa-fuerte">Frecuentes</span>
    </h2>
    <p class="mt-2 text-center text-base text-tinta-suave">Resolvemos las dudas más comunes.</p>

    <div class="mt-8 space-y-3">
      {
        preguntas.map((item) => (
          <details class="faq-item group rounded-tarjeta bg-white/85 shadow-suave">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-semibold text-tinta">
              <span>{item.pregunta}</span>
              <svg
                class="faq-icon h-5 w-5 shrink-0 text-rosa-fuerte transition-transform duration-300 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="faq-content">
              <div class="faq-content-inner">
                <p class="px-5 pb-5 text-sm leading-relaxed text-tinta-suave">{item.respuesta}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* El contenido se expande animando grid-template-rows de 0fr -> 1fr, lo que
     permite una transición de alto suave sin saltos ni reflow brusco. */
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-content-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item.is-open .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item.is-open .faq-content-inner {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    .faq-content-inner,
    .faq-icon {
      transition: none;
    }
  }
</style>

<script>
  // Controlamos la apertura manualmente para animar el alto de forma suave.
  // La clase `is-open` es la única fuente de verdad para decidir el toggle;
  // el atributo `open` solo controla si el contenido se renderiza. Mantenemos
  // `open` durante toda la animación de cierre y lo quitamos con un fallback por
  // tiempo (no dependemos de `transitionend`, que no siempre dispara con fr).
  const DURATION = 350;
  const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');

  items.forEach((item) => {
    const summary = item.querySelector('summary');
    if (!summary) return;

    summary.addEventListener('click', (event) => {
      event.preventDefault();

      if (item.classList.contains('is-open')) {
        // Cerrar: colapsamos con la animación y recién después ocultamos.
        item.classList.remove('is-open');
        window.setTimeout(() => {
          if (!item.classList.contains('is-open')) item.open = false;
        }, DURATION);
      } else {
        // Abrir: renderizamos el contenido y en el siguiente frame animamos.
        item.open = true;
        requestAnimationFrame(() => item.classList.add('is-open'));
      }
    });
  });
</script>
