---
import { site, whatsappLink } from '../data/site';

// URL absoluta a la página de gracias (Web3Forms exige URL completa).
const graciasUrl = new URL('/gracias', Astro.url).href;

const contactos = [
  {
    label: 'Instagram',
    value: site.instagramHandle,
    href: site.instagram,
    icon: 'instagram',
    bg: 'bg-rosa/45',
  },
  {
    label: 'Facebook',
    value: site.facebookHandle,
    href: site.facebook,
    icon: 'facebook',
    bg: 'bg-celeste/55',
  },
  {
    label: 'WhatsApp',
    value: site.whatsappDisplay,
    href: whatsappLink,
    icon: 'whatsapp',
    bg: 'bg-menta/55',
  },
];
---

<section id="contacto" class="bg-[linear-gradient(90deg,#fdf0f5_0%,#fcf5fa_22%,#f4f5fc_50%,#e9f3fb_66%,#ece4fb_100%)]">
  <div class="mx-auto max-w-sitio px-5 py-14 md:px-8 md:py-20">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Columna izquierda: título + copy + tarjetas de contacto -->
      <div>
        <h2 class="font-display text-5xl leading-[1.05] text-tinta sm:text-6xl lg:text-7xl">
          Cuéntanos que
          <br />
          <span class="text-rosa-fuerte">tienes en mente</span>
        </h2>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-tinta-suave">
          Si tienes una idea, proyecto o cotización en mente, escríbenos y conversemos.
          Estaremos felices de ayudarte a llevarlo al papel.
        </p>

        <div class="mt-9 space-y-4">
          {
            contactos.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener"
                class={`flex items-center gap-4 rounded-tarjeta ${c.bg} px-5 py-4 shadow-suave transition-transform hover:-translate-y-0.5`}
              >
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/80 shadow-sm">
                  {c.icon === 'instagram' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" aria-hidden="true">
                      <defs>
                        <radialGradient id="ig-grad" cx="30%" cy="107%" r="150%">
                          <stop offset="0%" stop-color="#fdf497" />
                          <stop offset="5%" stop-color="#fdf497" />
                          <stop offset="45%" stop-color="#fd5949" />
                          <stop offset="60%" stop-color="#d6249f" />
                          <stop offset="90%" stop-color="#285AEB" />
                        </radialGradient>
                      </defs>
                      <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#ig-grad)" />
                      <circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="1.8" />
                      <circle cx="17.2" cy="6.8" r="1.2" fill="#fff" />
                    </svg>
                  )}
                  {c.icon === 'facebook' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" fill="#1877F2" />
                      <path
                        d="M13.5 20v-6.5h2.1l.4-2.6h-2.5V9.2c0-.75.25-1.26 1.33-1.26H16V5.6c-.26-.03-1.13-.11-2.14-.11-2.12 0-3.57 1.29-3.57 3.67v2.04H8v2.6h2.29V20h3.21z"
                        fill="#fff"
                      />
                    </svg>
                  )}
                  {c.icon === 'whatsapp' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" fill="#25D366" />
                      <path
                        d="M12 6.5a5.4 5.4 0 00-4.6 8.2L6.6 17.5l2.9-.76A5.4 5.4 0 1012 6.5zm3.16 7.62c-.13.37-.77.72-1.06.74-.28.03-.54.13-1.82-.38-1.53-.6-2.5-2.16-2.58-2.26-.07-.1-.61-.81-.61-1.55 0-.74.39-1.1.53-1.25a.55.55 0 01.4-.19h.28c.09 0 .21-.03.33.25.13.3.44 1.05.48 1.12.04.08.06.17.01.27-.26.52-.54.5-.39.76.57.98 1.14 1.32 2.01 1.75.15.08.24.06.33-.04.09-.1.38-.44.48-.6.1-.14.2-.12.33-.07.14.05.86.4 1.01.48.15.07.25.11.28.17.04.07.04.37-.09.73z"
                        fill="#fff"
                      />
                    </svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-bold uppercase tracking-wide text-tinta-suave/80">{c.label}</span>
                  <span class="block truncate text-base font-semibold text-tinta">{c.value}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna derecha: formulario (Web3Forms) -->
      <div class="relative rounded-panel bg-[linear-gradient(140deg,#fde3ef_0%,#f6ecfa_45%,#e9e2fb_100%)] p-6 pt-10 shadow-tarjeta md:p-9 md:pt-12">
        <!-- Sobre decorativo -->
        <img
          src="https://res.cloudinary.com/v5ovpy2d/image/upload/v1789695381/escribenos.png"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute right-2 -top-10 h-24 w-auto drop-shadow-md sm:right-3 sm:h-28 md:-right-6 md:-top-16 md:h-40"
        />

        <h3 class="font-display text-4xl text-tinta">
          Escríbenos
        </h3>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-tinta-suave">
          Cuéntanos qué te gustaría crear y te responderemos para ayudarte a darle forma a tu idea.
        </p>

        <form action="https://api.web3forms.com/submit" method="POST" class="mt-7 space-y-5">
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde universocrafter.cl" />
          <input type="hidden" name="from_name" value="Universo Crafter Web" />
          <input type="hidden" name="redirect" value={graciasUrl} />
          <input type="hidden" name="replyto" value="" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="nombre" class="mb-1.5 block text-sm font-bold text-tinta">Nombre</label>
            <input
              id="nombre"
              type="text"
              name="name"
              required
              placeholder="Tu nombre"
              class="w-full rounded-2xl border border-white/60 bg-white/80 px-4 py-3.5 text-tinta shadow-sm outline-none transition-colors placeholder:text-tinta-suave/70 focus:border-lila-fuerte focus:bg-white"
            />
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-sm font-bold text-tinta">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full rounded-2xl border border-white/60 bg-white/80 px-4 py-3.5 text-tinta shadow-sm outline-none transition-colors placeholder:text-tinta-suave/70 focus:border-lila-fuerte focus:bg-white"
            />
          </div>

          <div>
            <label for="mensaje" class="mb-1.5 block text-sm font-bold text-tinta">¿Qué te gustaría crear?</label>
            <textarea
              id="mensaje"
              name="message"
              required
              rows="4"
              placeholder="Cuéntanos brevemente sobre tu proyecto, cantidad, fecha o cualquier detalle que quieras compartir."
              class="w-full resize-none rounded-2xl border border-white/60 bg-white/80 px-4 py-3.5 text-tinta shadow-sm outline-none transition-colors placeholder:text-tinta-suave/70 focus:border-lila-fuerte focus:bg-white"
            ></textarea>
          </div>

          <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>

          <button
            type="submit"
            class="flex w-full items-center justify-center gap-2 rounded-2xl bg-oscuro px-6 py-4 text-center text-base font-semibold text-white transition-transform hover:-translate-y-0.5"
          >
            Enviar mensaje
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Carga el widget de Cloudflare Turnstile (verificación anti-bot del formulario) -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

<script>
  // Marca que el usuario envió el formulario para autorizar el acceso a /gracias.
  const form = document.querySelector<HTMLFormElement>('#contacto form');
  form?.addEventListener('submit', () => {
    const emailInput = form.querySelector<HTMLInputElement>('#email');
    const replytoInput = form.querySelector<HTMLInputElement>('input[name="replyto"]');
    if (emailInput && replytoInput) {
      replytoInput.value = emailInput.value;
    }
    try {
      sessionStorage.setItem('uc:form-enviado', String(Date.now()));
    } catch (e) {
      /* sessionStorage no disponible: el envío continúa igual */
    }
  });
</script>
